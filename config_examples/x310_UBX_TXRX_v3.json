{
    "version": 3,
    "CONSTANTS": {
        "SAMPLE_RATE": 200e6,
        "FREQUENCY": 2.4e9,
        "TX_GAIN": 30,
        "RX_GAIN": 30
    },
    "devices": {
        "USRP0": {
            "type": "MultiUSRP",
            "mode": "TRX",
            "args": "addr0=192.168.10.34,send_frame_size=9000",
            "timeref": ["internal"],
            "clockref": ["internal"],
            "tx-subdev": ["A:0"],
            "rx-subdev": ["A:0"],
            "tx-channels": [
                {
                    "for-channels": [0],
                    "rate": "!SAMPLE_RATE",
                    "freq": "!FREQUENCY",
                    "gain": "!TX_GAIN",
                    "ant": "TX/RX"
                }
            ],
            "rx-channels": [
                {
                    "for-channels": [0],
                    "rate": "!SAMPLE_RATE",
                    "freq": "!FREQUENCY",
                    "gain": "!RX_GAIN",
                    "ant": "RX2"
                }
            ],
            "tx-streamers": [ { "channels": [0] } ],
            "rx-streamers": [ { "channels": [0] } ]
        }
    },
    "controllers": {
        "TX0": {
            "type": "CyclicTX",
            "streamers": ["USRP0:TX:0"],
            "syncmode": "USRP"
        },
        "RX0": {
            "type": "CyclicRX",
            "streamers": ["USRP0:RX:0"],
            "syncmode": "USRP"
        }
    },
    "port": 8888
}