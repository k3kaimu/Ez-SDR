{
    "version": 3,
    "devices": {
        "USRP0": {
            "type": "UHD_RFNoC",
            "args": "addr0=192.168.10.2",
            "timeref": ["internal"],
            "clockref": ["internal"],
            "connections": [
                "0/Replay#0:0 => 0/Radio#0:0"
            ],
            "radios": [
                {
                    "for": ["0/Radio#0:0", "0/Radio#1:0"],
                    "tx-args": "",
                    "tx-rate": 10e6,
                    "tx-freq": 2.4e9,
                    "tx-gain": 10,
                    "tx-ant": "TX/RX",
                    "tx-bw": 10e6,
                    "rx-args": "",
                    "rx-rate": 10e6,
                    "rx-freq": 2.4e9,
                    "rx-gain": 10,
                    "rx-ant": "RX2",
                    "rx-bw": 10e6
                }
            ],
            "tx-streamers": [
                { "type": "replay", "connect_to": ["0/Replay#0:0"] },
                { "type": "default", "connect_to": ["0/Radio#1:0"] }
            ],
            "rx-streamers": [
                { "type": "default", "connect_from": ["0/Radio#0:0"] },
                { "type": "default", "connect_from": ["0/Radio#1:0"] }
            ]
        }
    },
    "controllers": {
        "TX0": {
            "type": "CyclicTX",
            "streamers": ["USRP0:TX:0"]
        },
        "TX1": {
            "type": "CyclicTX",
            "streamers": ["USRP0:TX:1"]
        },
        "RX0": {
            "type": "CyclicRX",
            "streamers": ["USRP0:RX:0"]
        },
        "RX1": {
            "type": "CyclicRX",
            "streamers": ["USRP0:RX:1"]
        }
    },
    "port": 8888
}
